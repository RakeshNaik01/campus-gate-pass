{
  "expo": {
    "name": "Campus Gate Entry Pass",
    "slug": "campus-gate-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Campus Gate Pass to access camera for scanning QR codes and physical ID cards."
        }
      ]
    ]
  }
}
